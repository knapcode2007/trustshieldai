# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server & Network Configuration
PORT=3000
ENVIRONMENT="development"
VITE_API_BASE_URL="/api"

# Supabase Persistence & Authentication (configurable)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Python FastAPI Microservice Backend
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT="8000"
FASTAPI_URL="http://127.0.0.1:8000"

# External Threat Intelligence Feeds (Server-Side Only - Respecting Official Terms & Licensing)
# 1. Google Safe Browsing Lookup API v4
# Requires Google Cloud API Key with Safe Browsing API enabled.
# Console: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# Terms: https://developers.google.com/safe-browsing/terms
GOOGLE_SAFE_BROWSING_API_KEY=""

# 2. abuse.ch URLhaus Malware URL & Host Feed
# Free for research & defensive use. Optional Auth-Key for elevated rate limit tiers.
# Portal: https://urlhaus.abuse.ch/api/
# License: CC0 / Open Source.
URLHAUS_ENABLED="true"
URLHAUS_API_KEY=""

# 3. Cisco / OpenDNS PhishTank
# Requires free registered developer application key (app_key) and user-agent.
# Registration: https://phishtank.org/register.php
# Terms: https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=""

# 4. OpenPhish Zero-Day Phishing Telemetry
# Community feed enabled by default. Premium/commercial feed requires subscription key.
# Portal: https://openphish.com
OPENPHISH_ENABLED="true"
OPENPHISH_API_KEY=""

