# ==============================================================================
# TrustShield AI — Environment Configuration Blueprint
# ==============================================================================
# Security Notice:
# NEVER commit populated credentials or secrets to version control.
# NEVER prefix backend secrets with VITE_ (VITE_ variables are baked into browser client bundles).
#
# Classification Legend:
# [TIER 1 - REQUIRED IMMEDIATELY]: Needed for local development execution.
# [TIER 2 - REQUIRED AFTER BACKEND DEPLOYMENT]: Needed when deploying backend (e.g. Render / Cloud Run).
# [TIER 3 - REQUIRED FOR EXTERNAL APIS]: Needed only when enabling commercial / third-party feeds.
# [TIER 4 - OPTIONAL]: Feature flags, fine-tuning, and diagnostic logging toggles.
# ==============================================================================

# ------------------------------------------------------------------------------
# [TIER 1 - REQUIRED IMMEDIATELY] Local Development Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
PORT=3000
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT="8000"
FASTAPI_URL="http://127.0.0.1:8000"

# Public Client API Routing (Browser-accessible)
# For local development with Vite dev proxy: "/api"
# For production connecting directly to Render: "https://trustshield-api-zsv1.onrender.com/api"
VITE_API_BASE_URL="https://trustshield-api-zsv1.onrender.com/api"

# ------------------------------------------------------------------------------
# [TIER 2 - REQUIRED AFTER BACKEND DEPLOYMENT] Production Hosting (Render / Vercel)
# ------------------------------------------------------------------------------
# Backend public URL on Render
BACKEND_PUBLIC_URL="https://trustshield-api-zsv1.onrender.com"

# Frontend Origin for CORS enforcement on FastAPI backend
# (e.g. https://trustshield-ai.vercel.app or comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# App public URL for reverse links / redirect verification
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# [TIER 3 - REQUIRED FOR EXTERNAL APIS] Threat Intelligence & Persistence
# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Persistence & Authentication
# Safe for frontend / Vercel (Public anon key restricted by PostgreSQL RLS):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-or-sb_publishable_key"

# Backend-only Service Role Secret for Render (Bypasses RLS - NEVER expose to browser):
# Compatible with modern sb_secret_... keys as well as legacy JWT service_role keys.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-or-sb_secret_key"

# 2. Google Safe Browsing Lookup API v4
# Requires GCP API key with Safe Browsing API v4 enabled
# Console: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=""

# 3. abuse.ch URLhaus Threat Feed (Malware URLs)
# API key required for URLhaus query API
# Portal: https://urlhaus.abuse.ch/api/
URLHAUS_API_KEY=""

# 4. VirusTotal API v3 (Multi-Engine URL Reputation)
# Server-side API key for read-only reputation lookups (Free tier: max 4 req/min, 500 req/day)
# Portal: https://www.virustotal.com/gui/user/apikey
VIRUSTOTAL_API_KEY=""

# 5. Cisco / OpenDNS PhishTank
# Requires registered developer application key (app_key)
# Registration: https://phishtank.org/register.php
PHISHTANK_API_KEY=""

# 6. OpenPhish Zero-Day Feed
# Optional commercial feed subscription key
# Portal: https://openphish.com
OPENPHISH_API_KEY=""

# 7. Google Gemini AI / LLM Explanation Engine (Server-Side)
# Used for natural-language forensic reasoning on security reports
# Console: https://aistudio.google.com/
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# [TIER 4 - OPTIONAL] Diagnostics, Rate Limits & Feature Toggles
# ------------------------------------------------------------------------------
DEBUG="true"
LOG_LEVEL="INFO"
URLHAUS_ENABLED="true"
OPENPHISH_ENABLED="true"
CACHE_TTL_SECONDS=60

# 8. Experimental Hybrid Decision Shadow Mode (Phase 7C/8A)
# Strictly observational; does not alter legacy verdicts or public scan contracts.
HYBRID_SHADOW_ENABLED="false"
SHADOW_LOG_PATH="logs/hybrid_shadow_eval.jsonl"
SHADOW_MAX_LOG_BYTES=10485760
SHADOW_BACKUP_COUNT=3
SHADOW_RDAP_TIMEOUT=1.5
SHADOW_MAX_WORKERS=2
SHADOW_QUEUE_MAXSIZE=100
RDAP_CACHE_BACKEND="memory"
RDAP_SQLITE_PATH="data/rdap_cache.db"
RDAP_CACHE_TTL_SECONDS=86400

# 9. Staging Protection & Rate Limiting (Phase 8B)
# Optional access key protecting staging deployments from unauthorized internet scanning.
STAGING_ACCESS_KEY=""
STAGING_RATE_LIMIT_PER_MINUTE=60

